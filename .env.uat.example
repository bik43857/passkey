# Copy to .env.uat before running:
#   docker compose -f docker-compose.uat.yml --env-file .env.uat up -d --build
# Never commit the real .env.uat — it holds secrets.
# Kept as a separate file (not .env) so this can sit in the same checkout as
# a prod .env without one overwriting the other.

# The UAT domain, no scheme/path (e.g. "uat.example.com"). Used as both the
# WebAuthn RP ID and to build the HTTPS origin — must have its own DNS A
# record pointing at this server, distinct from the prod domain.
DOMAIN_NAME=uat.example.com

APP_NAME=My Passkey App (UAT)

DATABASE_NAME=authdb_uat
DATABASE_USERNAME=authuser
DATABASE_PASSWORD=change-me-to-a-long-random-value

# Generate with: openssl rand -base64 48
# Use a DIFFERENT value than prod's SESSION_SECRET — sharing one would let a
# session cookie minted by one environment be replayed against the other.
SESSION_SECRET=change-me-to-a-long-random-value

# Email certbot uses for expiry notices.
CERTBOT_EMAIL=you@example.com
