# Copy to .env in the repo root before running:
#   docker compose -f docker-compose.prod.yml up -d --build
# Never commit the real .env — it holds secrets.

# The exact domain users will visit, no scheme/path (e.g. "auth.example.com").
# Used as both the WebAuthn RP ID and to build the HTTPS origin — see the
# comments in docker-compose.prod.yml on why this has to be exact.
DOMAIN_NAME=auth.example.com

APP_NAME=My Passkey App

DATABASE_NAME=authdb
DATABASE_USERNAME=authuser
DATABASE_PASSWORD=change-me-to-a-long-random-value

# Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-value

# Email certbot uses for expiry notices (not used by docker-compose.prod.yml
# directly — pass it to the one-time certbot command in PHASE9_README.md).
CERTBOT_EMAIL=you@example.com
