# Copy to .env (or export in your shell) for local development.
# Never commit a real .env file.

DATABASE_URL=jdbc:postgresql://localhost:5432/authdb
DATABASE_USERNAME=authuser
DATABASE_PASSWORD=authpass

WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=My Passkey App
WEBAUTHN_ORIGIN=http://localhost:5173
WEBAUTHN_CHALLENGE_TTL=120

SESSION_SECRET=change-me-to-a-long-random-value
SESSION_TTL_HOURS=12
SESSION_COOKIE_SECURE=false

CORS_ALLOWED_ORIGINS=http://localhost:5173
